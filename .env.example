# Contact form delivery — SMTP via Nodemailer.
#
# All of this is optional. Without SMTP_HOST/SMTP_USER/SMTP_PASS the form still
# works: it falls back to opening the visitor's own mail client with the enquiry
# pre-filled, so a missing secret can never break the site.
#
# Set these in Vercel: Settings -> Environment Variables.

# Your mail host. Examples:
#   smtp.gmail.com          (Gmail / Google Workspace — use an App Password)
#   smtp.office365.com      (Microsoft 365)
#   smtp.zoho.eu            (Zoho Mail)
#   mail.emma-global.com    (whoever hosts emma-global.com mail)
SMTP_HOST=
# 587 = STARTTLS (most common). 465 = implicit TLS. Defaults to 587.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where enquiries land. Defaults to both addresses in src/lib/site-data.ts.
CONTACT_TO_EMAIL=Puwar.R@emma-global.com, patel.a@emma-global.com
# Envelope sender. Must be an address the SMTP account is allowed to send as,
# or the message will be rejected or land in spam.
CONTACT_FROM_EMAIL="Emma Global Website" <website@emma-global.com>

# Production origin — drives canonicals, sitemap, robots.txt, llms.txt and JSON-LD.
VITE_SITE_URL=https://emma-global.com
SITE_URL=https://emma-global.com
