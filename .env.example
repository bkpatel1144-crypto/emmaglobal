# Contact form delivery (optional).
#
# Without RESEND_API_KEY the contact form still works: it falls back to opening
# the visitor's own mail client with the enquiry pre-filled. Set these in the
# Vercel project (Settings -> Environment Variables) to deliver mail server-side.

# API key from https://resend.com
RESEND_API_KEY=

# Inbox that receives enquiries. Defaults to the address in src/lib/site-data.ts
CONTACT_TO_EMAIL=info@emmaglobal.com

# Verified sender for your Resend domain, e.g. "Emma Global <website@emmaglobal.com>"
CONTACT_FROM_EMAIL=
